const mongoose = require("mongoose")

const ConversationItemSchema = new mongoose.Schema({
    name: {
        type: String,
    },
    text: {
        type: String,
    },
    translation: {
        type: String,
    },
    audio: {
        type: String,
    },
    records: [
        {
            student: {
                type: mongoose.Schema.Types.ObjectId,
                ref: "Student",
                index:true

            },
            audio: {
                type: String,
            },
        }
    ],
    fastAudio: {
        type: String,
    },
    recordedDate: {
        type: Date,
        default: Date.now

    }
})

const ConversationItem = mongoose.model("ConversationItem", ConversationItemSchema)
module.exports = ConversationItem